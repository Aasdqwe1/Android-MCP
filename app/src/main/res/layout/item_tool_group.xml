<?xml version="1.0" encoding="utf-8"?>
<!--
  分组头。

  视觉定位：**不是卡片，也不铺满宽度做成色块分隔条**，而是一条「轻量标题行」——
  与 item_tool 的卡片共用同一套 6dp 外边距，靠颜色层次（surfaceContainer）与圆角
  和卡片区分主次。这样滚动时组头与卡片属于同一视觉节奏，不会像通栏色块那样把列表割裂。

  颜色全部走 M3 主题属性（?attr/colorSurfaceContainer / colorOnSurfaceVariant 等），
  自动跟随 DayNight 与动态取色，不在 values/colors.xml 里写死。
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="6dp"
    android:layout_marginEnd="6dp"
    android:layout_marginTop="10dp"
    android:layout_marginBottom="2dp"
    app:cardElevation="0dp"
    app:cardCornerRadius="14dp"
    app:cardBackgroundColor="?attr/colorSurfaceContainer"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:paddingStart="4dp"
        android:paddingEnd="8dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <!--
          可折叠区域 = 箭头 + 文字区。整块都能点：单独一个 22dp 箭头点起来太窄，
          而组头在视觉上是「标题行」，用户会自然地去点标题。开关刻意留在区域之外，
          否则点开关时会被折叠逻辑截走事件。
        -->
        <LinearLayout
            android:id="@+id/groupFoldArea"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGroupFold"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:contentDescription="展开或折叠本组"
            app:icon="@drawable/ic_group_expand"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconTint="?attr/colorOnSurfaceVariant"
            app:iconSize="22dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="6dp"
            android:paddingEnd="8dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvGroupName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    android:textColor="?attr/colorOnSurface" />

                <!--
                  启用计数。用 labelSmall + outline 色，弱于标题；
                  「3/30」这种信息在扫视时需要，但不需要抢注意力。
                -->
                <TextView
                    android:id="@+id/tvGroupCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:textColor="?attr/colorOnSurfaceVariant" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvGroupDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        </LinearLayout>

        <!--
          整组开关。tools 组头里语义是「一键全开 / 全关」；
          所有工具都被预设锁死时置灰（点了也不会生效，不该给假反馈）。
        -->
        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:contentDescription="启用或关闭本组全部工具" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
