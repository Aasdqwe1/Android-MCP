<?xml version="1.0" encoding="utf-8"?>
<!-- 列表弹窗的单个选项行：整行可点，行高统一，文字色由代码按语义设定 -->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dialog_choice_height"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:paddingStart="@dimen/dialog_padding_horizontal"
    android:paddingEnd="@dimen/dialog_padding_horizontal"
    android:textColor="?attr/colorOnSurface"
    android:textSize="@dimen/dialog_choice_text_size" />
